# NestJS API Configuration

# Server
PORT=4000
NODE_ENV=development

# gx-daemon connection
DAEMON_URL=http://localhost:8010
DAEMON_API_KEY=

# JWT (generate with: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Users database path
USERS_DB_PATH=./data/users.db

# CORS - Next.js frontend origin
CORS_ORIGINS=http://localhost:3000

# External Create Order API (X-API-Key)
EXTERNAL_API_KEY=
EXTERNAL_API_CLIENT_ID=1

# Shared FASTQ roots — API writes here; paths must be readable by gx-daemon
# Local example (absolute path recommended):
# FASTQ_DIR_CARRIER=/home/you/gx-portal/data/fastq/carrier
FASTQ_DIR_CARRIER=./data/fastq/carrier
FASTQ_DIR_SGNIPT=./data/fastq/sgnipt
# When API runs in Docker and daemon is on the host, set daemon-visible paths
# (same bind mount, host absolute path). Leave empty if API and daemon share paths.
# FASTQ_DIR_CARRIER_DAEMON=/absolute/host/path/to/data/fastq/carrier
# FASTQ_DIR_SGNIPT_DAEMON=/absolute/host/path/to/data/fastq/sgnipt
