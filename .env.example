# Root .env for Docker Compose
JWT_SECRET=change-me-to-a-random-64-char-string

# External Create Order API
EXTERNAL_API_KEY=
EXTERNAL_API_CLIENT_ID=1
# Container paths (API writes here)
FASTQ_DIR_CARRIER=/data/fastq/carrier
FASTQ_DIR_SGNIPT=/data/fastq/sgnipt
# Host bind-mount sources
FASTQ_DIR_CARRIER_HOST=./data/fastq/carrier
FASTQ_DIR_SGNIPT_HOST=./data/fastq/sgnipt
# Paths stored on orders for host gx-daemon (absolute; required if daemon is not in Docker)
# FASTQ_DIR_CARRIER_DAEMON=/home/you/gx-portal/data/fastq/carrier
# FASTQ_DIR_SGNIPT_DAEMON=/home/you/gx-portal/data/fastq/sgnipt
